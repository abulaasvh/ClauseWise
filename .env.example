# -----------------------------------------------------------------------------
# ClauseWise Environment Configuration Template
# -----------------------------------------------------------------------------

# AI Provider Keys (Server-side)
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
VOYAGE_API_KEY=your-voyage-api-key-here

# Supabase Configuration (Optional - in-memory fallback is used if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# UI Toggles
# Set to "true" to display the "Supabase Database & Free API Setup" (BYOK) modal button
# in the navigation bar. If unset or "false", the setup modal button is hidden and the
# application relies entirely on the server-side environment variables above.
NEXT_PUBLIC_SHOW_BYOK_BUTTON=true
